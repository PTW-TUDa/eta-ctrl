{
    "setup": {
        "environment_import": "examples.damped_oscillator.damped_oscillator.DampedOscillatorEnv",
        "agent_import": "stable_baselines3.ppo.PPO",
        "vectorizer_import": "stable_baselines3.common.vec_env.SubprocVecEnv",
        "policy_import": "stable_baselines3.ppo.MultiInputPolicy",
        "tensorboard_log": true,
        "monitor_wrapper": true,
        "norm_wrapper_obs": true,
        "norm_wrapper_reward": true
    },

    "settings": {
        "sampling_time": 0.5,
        "episode_duration": 100,
        "n_episodes_play": 1,
        "n_episodes_learn": 2000,
        "n_environments": 4,
        "verbose": 2,
        "seed": 6437698,
        "plot_interval": 50,
        "sim_steps_per_sample": 5,
        "environment": {
            "scale_actions": true
        },
        "agent": {     // Parameters for PPO Algorithm
            "n_steps": 1024,
            "gae_lambda": 0.95,
            "gamma": 0.9,
            "n_epochs": 10,
            "ent_coef": 0.001,
            "learning_rate": 0.0001,
            "batch_size": 64
        }
    }
}
